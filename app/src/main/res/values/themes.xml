<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Platform.Theme.XiaoAiTypeUnblock" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.XiaoAiTypeUnblock" parent="Platform.Theme.XiaoAiTypeUnblock">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_variant</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The window and its dim only fade; the sheet itself slides on a spring. -->
    <style name="Animation.XiaoAiTypeUnblock.Sheet" parent="">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
